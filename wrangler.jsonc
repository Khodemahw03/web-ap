{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ap",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d87ab48e-183e-4017-aefd-89c4142301f5","database_name": "data2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5ac808754a8545edbb52ea467d9d3da3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
